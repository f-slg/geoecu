    given-names: "Ronald Fabricio"
    orcid: "https://orcid.org/0000-0001-5077-1522"
version: "0.4.2"
date-released: "2026-11-14"
doi: 10.32614/CRAN.package.geoecu
license: MIT
url: "https://f-slg.github.io/geoecu/"
repository-code: "https://github.com/f-slg/geoecu"
repository: "https://CRAN.R-project.org/package=geoecu"
keywords:
  - R
  - Ecuador
  - maps
  - sf
  - administrative boundaries
  - DPA
  - public health
references:
  - type: data
    title: "Organización Territorial del Estado: límites territoriales internos (provincial, cantonal y parroquial)"
    authors:
      - name: "Comité Nacional de Límites Internos (CONALI), Ministerio de Gobierno del Ecuador"
    year: 2026
    url: "https://www.datosabiertos.gob.ec/dataset/organizacion-territorial-parroquial"
    notes: "Datos abiertos, licencia CC BY. Versión del 17 de julio de 2026."
